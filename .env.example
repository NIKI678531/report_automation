# Compose secrets. Copy to `.env` beside compose.yaml and fill in; `.env` itself is gitignored.
# Every variable below is referenced as ${VAR:?...} in compose.yaml, so `docker compose up` stops
# with a named error rather than starting a service on a published default password.
#
# Service-level application settings (news providers, CDB views, FMP) live in backend/.env.example.

# --- MySQL ---------------------------------------------------------------------------------
# The database is created with utf8mb4; the API connects with ?charset=utf8mb4. Report content is
# Traditional and Simplified Chinese and MySQL's legacy three-byte "utf8" truncates it.
MYSQL_PASSWORD=replace-with-a-generated-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-generated-password

# --- Artifact download signing -------------------------------------------------------------
# HMAC key for the TTL-bound artifact download URLs. Must be identical in `api` and `worker`, at
# least 32 characters, and generated - not typed. The application refuses to start outside
# AUTH_MODE=LOCAL while this is still the repository default.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DOWNLOAD_SECRET=replace-with-32-or-more-random-characters

# --- Authentication ------------------------------------------------------------------------
# LOCAL trusts X-User-Role / X-User-ID / X-Product-Scope request headers and is for development
# only. ENTRA validates a Microsoft Entra access token: signature against the tenant JWKS, then
# audience, issuer and expiry, with the role and product scope read from claims.
# Tenant-side setup, and what each rejection error_code means: docs/entra-setup.md.
# ENTRA also needs the extra that carries signature verification:
#   pip install -e "./backend[entra]"
AUTH_MODE=LOCAL
ENTRA_TENANT_ID=
# The API's application ID URI or client id. A token minted for any other audience is rejected.
ENTRA_AUDIENCE=
# Optional overrides; derived from the tenant id when blank.
ENTRA_ISSUER=
# Claim carrying the app role (VIEWER / EDITOR / REVIEWER / ADMIN). Most privileged one wins.
ENTRA_ROLE_CLAIM=roles
# Claim carrying the product codes this caller may see, or `*`. Clear this variable only if the
# directory does not model product scope - a token with no scope claim is otherwise refused.
ENTRA_PRODUCT_SCOPE_CLAIM=product_scope

# --- Artifact storage ------------------------------------------------------------------------
# LOCAL keeps rendered artifacts on the container's own disk and is for local runs only. The
# deployment has no persistent volume, so anything other than AUTH_MODE=LOCAL refuses to start on
# it: the artifact would be lost at the next restart and invisible to the other replicas.
# S3 covers every S3-compatible store (Volcengine TOS, MinIO, AWS S3). The API and the worker must
# name the same bucket - the worker writes what the API later serves.
STORAGE_BACKEND=LOCAL
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_PREFIX=
# Leave blank when the pod assumes a role; otherwise inject from the secret store, never a file.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# `virtual` is bucket.endpoint (TOS, AWS); `path` is endpoint/bucket (MinIO and most gateways).
S3_ADDRESSING_STYLE=virtual

# --- Browser client ------------------------------------------------------------------------
# Origins allowed to call the API with credentials. Behind the bundled nginx the UI is
# same-origin, so this only needs the origins that reach the API directly.
CORS_ALLOW_ORIGINS=http://localhost:8080

# --- Sizing --------------------------------------------------------------------------------
# Keep UPLOAD_MAX_BYTES at or below nginx's client_max_body_size in frontend/nginx.conf.
UPLOAD_MAX_BYTES=20971520
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# Must stay below the MySQL server's wait_timeout, or the pool hands out closed connections.
DB_POOL_RECYCLE_SECONDS=1800
