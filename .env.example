# Local image validation only. Copy to .env; requires Docker Compose >= 2.30 (raw env_file).
# No services are started by changing these files. MySQL/Redis data is disposable.
# Use a URL-safe MYSQL_PASSWORD and repeat it in DATABASE_URL; encode reserved characters in URLs.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
DATABASE_URL=mysql+pymysql://commentary:REPLACE-ME@mysql:3306/commentary?charset=utf8mb4
DOWNLOAD_SECRET=
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_PREFIX=fund-commentary/local
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
DA_REPORT_AUTO_LOAD=false
DATAWAREHOUSE_PERFORMANCE_ENABLED=false
DATAWAREHOUSE_CONSTITUENTS_ENABLED=false
FMP_CONSTITUENT_RETURNS_ENABLED=false
TRANSLATION_PROVIDER=DISABLED
