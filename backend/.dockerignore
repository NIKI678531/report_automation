# This service builds with `context: ./backend`, so Docker reads this file rather than the root one.

# Secrets: MARKETAUX_API_KEY and friends come from the environment, never baked into a layer.
.env*
**/.env*
*.sql
**/*.sql
*.sql.gz
**/*.sql.gz
*.sqlite*
**/*.sqlite*
*.pem
**/*.pem
*.key
**/*.key
*.pfx
**/*.pfx
*.p12
**/*.p12

.venv/
__pycache__/
**/__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Local databases are recreated by alembic on start.
*.db
**/*.db
