# Which provider answers a fetch that names none. DA_REPORT | MARKETAUX
NEWS_PROVIDER=DA_REPORT

# Marketaux authenticates with an `api_token` query parameter and offers no header alternative, so this
# token is visible to the vendor's access logs and any intermediate proxy. Rotate it accordingly.
# See docs/news-sources-and-data-imports.md for the documented deviation.
MARKETAUX_API_KEY=replace-with-secret-from-approved-secret-store
MARKETAUX_BASE_URL=https://api.marketaux.com/v1
MARKETAUX_TIMEOUT_SECONDS=15
MARKETAUX_MAX_RESULTS=100
MARKETAUX_LANGUAGE=en
MARKETAUX_ALLOWED_HOSTS=api.marketaux.com

# DA-Report development: direct read-only SQLite path. Production should leave this unset and use
# a short-lived TOS/S3-compatible presigned URL plus the required immutable object checksum below.
DA_REPORT_SQLITE_PATH=C:/Users/you/Downloads/da_report.sqlite
DA_REPORT_SQLITE_SHA256=replace-with-versioned-object-sha256
DA_REPORT_OBJECT_URL=
DA_REPORT_CACHE_DIR=
DA_REPORT_MAX_BYTES=536870912
DA_REPORT_TIMEOUT_SECONDS=30
# Create a DA_REPORT_AUTO snapshot when a report is created. Disable only for isolated tests.
DA_REPORT_AUTO_LOAD=true

# Historical Performance (Page 02) reads precomputed 1M/3M/6M/YTD returns from read-only CDB views.
# Production injects the password from the approved secret store. Never commit it to an env file.
DATAWAREHOUSE_PERFORMANCE_ENABLED=true
DATAWAREHOUSE_MYSQL_HOST=
DATAWAREHOUSE_MYSQL_PORT=3306
DATAWAREHOUSE_MYSQL_DATABASE=
DATAWAREHOUSE_MYSQL_USERNAME=
DATAWAREHOUSE_MYSQL_PASSWORD=
DATAWAREHOUSE_MYSQL_SSL_CA=
DATAWAREHOUSE_MYSQL_SSL_VERIFY_IDENTITY=true
DATAWAREHOUSE_CLASS_MASTER_VIEW=view_ads_busi_product_fundinfo_class_f_p
DATAWAREHOUSE_FUND_RETURNS_VIEW=view_ads_busi_performance_class_returns_f_p
DATAWAREHOUSE_INDEX_RETURNS_VIEW=view_ads_busi_performance_index_returns_f_p
DATAWAREHOUSE_CONSTITUENTS_ENABLED=true
DATAWAREHOUSE_CONSTITUENTS_VIEW=view_ads_busi_market_index_constituent_price_daily_f_p

# Offline development and tests may use an immutable SQLite snapshot instead. This fallback is
# selected only when DATAWAREHOUSE_MYSQL_HOST is unset. A deployed object cache remains ephemeral.
DATAWAREHOUSE_SQLITE_PATH=C:/Users/you/Downloads/td_attribution_cdb_test_2025/td_attribution_cdb_test_2025.db
DATAWAREHOUSE_SQLITE_SHA256=
DATAWAREHOUSE_OBJECT_URL=
DATAWAREHOUSE_CACHE_DIR=
DATAWAREHOUSE_MAX_BYTES=1073741824
DATAWAREHOUSE_TIMEOUT_SECONDS=30

# Page 04 constituent returns. FMP authenticates through the `apikey` request header; the key is
# never placed in a URL, audit event, snapshot, exception message, or generated artifact.
FMP_CONSTITUENT_RETURNS_ENABLED=true
FMP_API_KEY=replace-with-secret-from-approved-secret-store
FMP_BASE_URL=https://financialmodelingprep.com/stable
FMP_TIMEOUT_SECONDS=20
FMP_BOUNDARY_LOOKBACK_DAYS=14
FMP_ALLOWED_HOSTS=financialmodelingprep.com

# Open the TESTING lane, which is what the GOLDEN_FIXTURE source policy binds on. That fixture is
# transcribed from an approved report rather than derived from a source system, so its artifacts are
# watermarked and named `TESTING-…`. Leave this off outside local development and CI: with it off,
# a fixture-backed report cannot be created at all.
ALLOW_TESTING_LANE=false
