# Backend settings, read by app/core/config.py. `load_dotenv(override=False)` means the real process
# environment always wins, so a deployment can supply any of these without editing a file.
# Compose-level secrets (MySQL password, DOWNLOAD_SECRET) live in the repo-root .env.example.

# Blank falls back to sqlite:///var/commentary.db, anchored to the repository root. Production is
# MySQL 8 and must carry `?charset=utf8mb4` - the legacy three-byte `utf8` truncates Chinese text.
DATABASE_URL=
# Connection pool. pool_recycle must stay below the MySQL server's wait_timeout, or the pool hands
# out connections the server has already closed and the first query of the day fails.
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_CONNECT_TIMEOUT_SECONDS=10
# SQL echo is a debugging aid only; it prints bound parameters, which include report content.
DB_ECHO=false

# LOCAL trusts the X-User-Role / X-User-ID / X-Product-Scope headers and is for development only.
# ENTRA validates a Microsoft Entra bearer token and requires the ENTRA_* settings below plus the
# `entra` install extra; the application refuses to start if any of them is missing or unsafe.
# Tenant-side setup and the error_code table: docs/entra-setup.md.
# Check any environment with: python scripts/check_deployment.py [--token "$ACCESS_TOKEN"]
AUTH_MODE=LOCAL
ENTRA_TENANT_ID=
# The API's application ID URI or client id. A token minted for any other audience is rejected.
ENTRA_AUDIENCE=
# Derived from the tenant id when blank. Set explicitly for a v1.0-issuer or B2C tenant.
ENTRA_ISSUER=
ENTRA_JWKS_URL=
ENTRA_JWKS_CACHE_SECONDS=3600
ENTRA_JWKS_TIMEOUT_SECONDS=5
# Clock-skew tolerance for exp/nbf, in seconds. Keep small.
ENTRA_LEEWAY_SECONDS=60
# Claim carrying the app role (VIEWER / EDITOR / REVIEWER / ADMIN); the most privileged one wins.
ENTRA_ROLE_CLAIM=roles
# Claim carrying the product codes this caller may read. Clear it only if the directory does not
# model product scope - with it set, a token that carries no scope claim is refused.
ENTRA_PRODUCT_SCOPE_CLAIM=product_scope
# Signature algorithms accepted from the token header. Never add HS* or none: those would let a
# caller sign their own token with a key the API already knows.
ENTRA_ALLOWED_ALGORITHMS=RS256

# Where rendered artifacts live. LOCAL writes to var/output and is for workstations and UAT only:
# the deployment provides no persistent volume, so a restart takes every artifact with it and a
# second replica cannot serve one the first produced. A non-LOCAL AUTH_MODE refuses to start on it.
# S3 speaks the S3-compatible API - Volcengine TOS, MinIO and AWS S3 all qualify - and needs the
# install extra that carries the client:  pip install -e "./backend[storage]"
STORAGE_BACKEND=LOCAL
S3_BUCKET=
# Required for any vendor that is not AWS; blank uses the AWS endpoint for S3_REGION.
S3_ENDPOINT_URL=
S3_REGION=
# Optional key prefix, so one bucket can hold several environments without them colliding.
S3_PREFIX=
# Leave both blank when the pod assumes a role; otherwise inject them from the secret store.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# `virtual` is bucket.endpoint (TOS, AWS); `path` is endpoint/bucket (MinIO and most gateways).
S3_ADDRESSING_STYLE=virtual

# HMAC key for TTL-bound artifact download URLs; the API and the Celery worker must share one
# value. At least 32 generated characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DOWNLOAD_SECRET=
DOWNLOAD_TTL_SECONDS=300

# Origins allowed to call the API from a browser with credentials, comma separated. Behind the
# bundled nginx the UI is same-origin and this only needs origins that reach the API directly.
CORS_ALLOW_ORIGINS=http://localhost:5173

# Upload ceilings, enforced while streaming so an oversized body is refused rather than buffered.
# Keep UPLOAD_MAX_BYTES at or below nginx's client_max_body_size in frontend/nginx.conf.
UPLOAD_MAX_BYTES=20971520
UPLOAD_BATCH_MAX_FILES=20
UPLOAD_BATCH_MAX_BYTES=104857600
CATALOG_UPLOAD_MAX_BYTES=5242880

# Which provider answers a fetch that names none. DA_REPORT | MARKETAUX
NEWS_PROVIDER=DA_REPORT

# Marketaux authenticates with an `api_token` query parameter and offers no header alternative, so this
# token is visible to the vendor's access logs and any intermediate proxy. Rotate it accordingly.
# See docs/news-sources-and-data-imports.md for the documented deviation.
MARKETAUX_API_KEY=replace-with-secret-from-approved-secret-store
MARKETAUX_BASE_URL=https://api.marketaux.com/v1
MARKETAUX_TIMEOUT_SECONDS=15
MARKETAUX_MAX_RESULTS=100
MARKETAUX_LANGUAGE=en
MARKETAUX_ALLOWED_HOSTS=api.marketaux.com

# DA-Report development: direct read-only SQLite path. Production should leave this unset and use
# a short-lived TOS/S3-compatible presigned URL plus the required immutable object checksum below.
DA_REPORT_SQLITE_PATH=C:/Users/you/Downloads/da_report.sqlite
DA_REPORT_SQLITE_SHA256=replace-with-versioned-object-sha256
DA_REPORT_OBJECT_URL=
DA_REPORT_CACHE_DIR=
DA_REPORT_MAX_BYTES=536870912
DA_REPORT_TIMEOUT_SECONDS=30
# Create a DA_REPORT_AUTO snapshot when a report is created. Disable only for isolated tests.
DA_REPORT_AUTO_LOAD=true

# Historical Performance (Page 02) reads precomputed 1M/3M/6M/YTD returns from read-only CDB views.
# Production injects the password from the approved secret store. Never commit it to an env file.
DATAWAREHOUSE_PERFORMANCE_ENABLED=true
DATAWAREHOUSE_MYSQL_HOST=
DATAWAREHOUSE_MYSQL_PORT=3306
DATAWAREHOUSE_MYSQL_DATABASE=
DATAWAREHOUSE_MYSQL_USERNAME=
DATAWAREHOUSE_MYSQL_PASSWORD=
DATAWAREHOUSE_MYSQL_SSL_CA=
DATAWAREHOUSE_MYSQL_SSL_VERIFY_IDENTITY=true
DATAWAREHOUSE_CLASS_MASTER_VIEW=view_ads_busi_product_fundinfo_class_f_p
DATAWAREHOUSE_FUND_RETURNS_VIEW=view_ads_busi_performance_class_returns_f_p
DATAWAREHOUSE_INDEX_RETURNS_VIEW=view_ads_busi_performance_index_returns_f_p
DATAWAREHOUSE_CONSTITUENTS_ENABLED=true
DATAWAREHOUSE_CONSTITUENTS_VIEW=view_ads_busi_market_index_constituent_price_daily_f_p
# Existing approved fund-level valuation view used to populate AUM while the unified KPI view is pending.
DATAWAREHOUSE_FUND_AUM_VIEW=view_ads_busi_valuation_nav_fund_level_exposure_1_f_p
# Optional approved unified view for AUM, daily turnover and the report-month trading calendar.
# Leave unset until the data owner has provisioned and granted the documented contract.
DATAWAREHOUSE_FUND_KPI_VIEW=

# Offline development and tests may use an immutable SQLite snapshot instead. This fallback is
# selected only when DATAWAREHOUSE_MYSQL_HOST is unset. A deployed object cache remains ephemeral.
DATAWAREHOUSE_SQLITE_PATH=C:/Users/you/Downloads/td_attribution_cdb_test_2025/td_attribution_cdb_test_2025.db
DATAWAREHOUSE_SQLITE_SHA256=
DATAWAREHOUSE_OBJECT_URL=
DATAWAREHOUSE_CACHE_DIR=
DATAWAREHOUSE_MAX_BYTES=1073741824
DATAWAREHOUSE_TIMEOUT_SECONDS=30

# Page 04 constituent returns. FMP authenticates through the `apikey` request header; the key is
# never placed in a URL, audit event, snapshot, exception message, or generated artifact.
FMP_CONSTITUENT_RETURNS_ENABLED=true
FMP_API_KEY=replace-with-secret-from-approved-secret-store
FMP_BASE_URL=https://financialmodelingprep.com/stable
FMP_TIMEOUT_SECONDS=20
FMP_BOUNDARY_LOOKBACK_DAYS=14
FMP_ALLOWED_HOSTS=financialmodelingprep.com

# Open the TESTING lane, which is what the GOLDEN_FIXTURE source policy binds on. That fixture is
# transcribed from an approved report rather than derived from a source system, so its artifacts are
# watermarked and named `TESTING-…`. Leave this off outside local development and CI: with it off,
# a fixture-backed report cannot be created at all.
ALLOW_TESTING_LANE=false
