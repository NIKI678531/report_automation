ARG BACKEND_BASE_IMAGE
FROM ${BACKEND_BASE_IMAGE}

ARG PLAYWRIGHT_VERSION
ENV PYTHONPATH=/app/backend \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/tmp \
    TZ=Asia/Hong_Kong

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates tzdata tini fonts-crosextra-carlito fonts-noto-cjk fonts-noto-cjk-extra \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 commentary \
    && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /tmp --shell /usr/sbin/nologin commentary

WORKDIR /app/backend
COPY pyproject.toml ./
RUN test -n "$PLAYWRIGHT_VERSION" \
    && python -c "import tomllib; project = tomllib.load(open('pyproject.toml', 'rb'))['project']; print('\n'.join(project['dependencies'] + [dependency for extra in ('render', 'entra', 'storage') for dependency in project['optional-dependencies'][extra]]))" > /tmp/commentary-requirements.txt \
    && pip install --no-cache-dir -r /tmp/commentary-requirements.txt "playwright==$PLAYWRIGHT_VERSION" \
    && rm /tmp/commentary-requirements.txt

COPY app ./app
COPY migrations ./migrations
COPY alembic.ini vm-entrypoint.sh ./
RUN pip install --no-cache-dir --no-deps . \
    && chmod 0555 /app/backend/vm-entrypoint.sh \
    && mkdir -p /app/var/output \
    && chmod 1777 /app/var/output

USER 10001:10001
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=40s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/v1/health', timeout=3)"
ENTRYPOINT ["/usr/bin/tini", "--", "sh", "/app/backend/vm-entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]