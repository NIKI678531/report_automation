# Copy to .env.vm on the VM; inject secrets through the approved secret store.
# The deployment files are standalone. Do not merge them with compose.yaml.
# Use unique release tags for builds; production may use the resulting image digests.
API_IMAGE=
WEB_IMAGE=
BACKEND_BASE_IMAGE=
PLAYWRIGHT_VERSION=
NODE_BASE_IMAGE=
NGINX_BASE_IMAGE=

# TLS terminates at the approved proxy on this VM, forwarding to localhost:18081.
PUBLIC_HOST=
PUBLIC_ORIGIN=
VM_HTTP_PORT=18081

# External application services. URL-encode usernames/passwords in connection URLs.
# DATABASE_URL: mysql+pymysql://.../commentary?charset=utf8mb4
# REDIS_URL: use the approved dedicated broker/database, preferably rediss with
# certificate verification. Do not reuse another application's Celery database.
DATABASE_URL=
REDIS_URL=
DOWNLOAD_SECRET=
ENTRA_TENANT_ID=
ENTRA_AUDIENCE=
ENTRA_ISSUER=
ENTRA_JWKS_URL=
ENTRA_ROLE_CLAIM=roles
ENTRA_PRODUCT_SCOPE_CLAIM=product_scope

# TOS uses the S3-compatible adapter; these settings are shared by all backend services.
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_PREFIX=commentary/production
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ADDRESSING_STYLE=virtual

# API + worker + transient migration memory must fit the shared VM's approved budget.
API_CPUS=2.0
API_MEMORY=2g
WORKER_CPUS=2.0
WORKER_MEMORY=3g
WORKER_CONCURRENCY=2
WEB_CPUS=0.5
WEB_MEMORY=256m
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_TIMEOUT_SECONDS=30
DB_CONNECT_TIMEOUT_SECONDS=10
UPLOAD_BATCH_MAX_FILES=20

# Business feeds are separate from the application database; supply approved read-only access.
NEWS_PROVIDER=DA_REPORT
DA_REPORT_OBJECT_URL=
DA_REPORT_SQLITE_SHA256=
DA_REPORT_AUTO_LOAD=true
MARKETAUX_API_KEY=
MARKETAUX_BASE_URL=https://api.marketaux.com/v1
DATAWAREHOUSE_PERFORMANCE_ENABLED=true
DATAWAREHOUSE_CONSTITUENTS_ENABLED=true
DATAWAREHOUSE_MYSQL_HOST=
DATAWAREHOUSE_MYSQL_PORT=3306
DATAWAREHOUSE_MYSQL_DATABASE=
DATAWAREHOUSE_MYSQL_USERNAME=
DATAWAREHOUSE_MYSQL_PASSWORD=
DATAWAREHOUSE_MYSQL_SSL_CA=/etc/ssl/certs/ca-certificates.crt
DATAWAREHOUSE_CLASS_MASTER_VIEW=view_ads_busi_product_fundinfo_class_f_p
DATAWAREHOUSE_FUND_RETURNS_VIEW=view_ads_busi_performance_class_returns_f_p
DATAWAREHOUSE_INDEX_RETURNS_VIEW=view_ads_busi_performance_index_returns_f_p
DATAWAREHOUSE_CONSTITUENTS_VIEW=view_ads_busi_market_index_constituent_price_daily_f_p
DATAWAREHOUSE_FUND_AUM_VIEW=view_ads_busi_valuation_nav_fund_level_exposure_1_f_p
DATAWAREHOUSE_FUND_KPI_VIEW=
FMP_CONSTITUENT_RETURNS_ENABLED=true
FMP_API_KEY=
FMP_BASE_URL=https://financialmodelingprep.com/stable
FMP_TIMEOUT_SECONDS=20
FMP_BOUNDARY_LOOKBACK_DAYS=14