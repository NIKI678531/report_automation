ARG NODE_BASE_IMAGE
ARG NGINX_BASE_IMAGE

FROM ${NODE_BASE_IMAGE} AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY frontend/package.json ./frontend/package.json
RUN npm ci
COPY frontend ./frontend
RUN npm run build

FROM ${NGINX_BASE_IMAGE}
USER root
RUN apk add --no-cache tzdata \
    && rm -f /etc/nginx/conf.d/default.conf \
    && mkdir -p /etc/nginx/templates /etc/nginx/conf.d \
    && chmod 1777 /etc/nginx/conf.d /tmp
COPY frontend/nginx/vm.conf.template /etc/nginx/templates/default.conf.template
COPY frontend/docker-entrypoint.d/25-require-rendered-config.sh /docker-entrypoint.d/25-require-rendered-config.sh
COPY --from=build /app/frontend/dist /usr/share/nginx/html
RUN chmod 0555 /docker-entrypoint.d/25-require-rendered-config.sh
ENV TZ=Asia/Hong_Kong
USER 101:101
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=3 \
    CMD wget -q --spider http://127.0.0.1:8080/healthz